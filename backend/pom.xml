<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml - Archivo de configuracion de Maven
  Aqui se declaran:
    - El "padre" spring-boot-starter-parent (trae versiones probadas de todo).
    - Las dependencias (librerias) que usa el proyecto.
    - La version de Java (17).
  Maven descarga estas librerias automaticamente cuando se construye el proyecto.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto padre: Spring Boot administra las versiones de las dependencias -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- Datos de identificacion del proyecto -->
    <groupId>com.uao</groupId>
    <artifactId>rutas-turisticas</artifactId>
    <version>1.0.0</version>
    <name>rutas-turisticas</name>
    <description>API RESTful para gestionar rutas turisticas - Tecnicas de Programacion</description>

    <properties>
        <!-- Version de Java que se usa para compilar y ejecutar -->
        <java.version>17</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>

        <!-- Spring Web: permite crear controladores REST (endpoints GET/POST/PUT/DELETE) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: permite trabajar con la base de datos usando objetos Java -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validacion: anotaciones como @NotNull, @NotBlank para validar los datos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Base de datos H2: base de datos en memoria, ideal para pruebas (no requiere instalar nada) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SpringDoc OpenAPI: genera automaticamente la documentacion Swagger en /swagger-ui/index.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- Dependencias para pruebas (JUnit, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Plugin que permite ejecutar la app con: mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
